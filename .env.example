# ==========================================================================
# Torob Travel — environment template
#
#   cp .env.example .env      # then fill in every [REQUIRED] value
#
# • Never commit the real .env or any .env.* — see .gitignore section 1.
# • Comments live on their OWN lines: scripts/run_with_env.py reads values
#   verbatim, so `KEY=value  # note` would make "value  # note" the value.
# • Docker Compose reads `.env` automatically (variable substitution).
# • Host-run python services read process env: use
#   `python scripts/run_with_env.py <module>` or `set -a; . ./.env; set +a`.
# • Pipeline variables (pipelines/common/config.py) treat an empty value as
#   unset; BFF variables marked "commented out" do NOT — leave them commented
#   unless you set a real value.
#
# Zero-config paths (no .env needed): the BFF mock catalog
# (TOROB_FORCE_MOCK=1) and the itinerary planner's demo seed.
# ==========================================================================

# ── [REQUIRED for live scraping] Supplier endpoint matrix ─────────────────
# Private reverse-engineering artifacts — deliberately absent from the
# codebase (pipelines/worker_settings.py wires them in). An enabled supplier
# with any of its values missing makes the worker refuse to start, naming
# the variable. Without this matrix a clone is not a working scraper.
#   FLYTODAY_SEARCH_PATH   search endpoint path (blocking POST)
#   FLYTODAY_TOKEN_PATH    anonymous session-token endpoint path
#   ALIBABA_SEARCH_PATH    search endpoint path (POST, then poll)
#   ALIBABA_AB_CHANNEL     analytics channel header value from a live session
FLYTODAY_BASE_URL=https://www.flytoday.ir
FLYTODAY_SEARCH_PATH=
FLYTODAY_TOKEN_PATH=
ALIBABA_BASE_URL=https://ws.alibaba.ir
ALIBABA_SEARCH_PATH=
ALIBABA_AB_CHANNEL=

# ── [REQUIRED for docker compose] Local infrastructure credentials ────────
# No defaults: compose refuses to start until both passwords are set. Use
# long random values (e.g. `python -c "import secrets; print(secrets.token_urlsafe(24))"`).
# Postgres applies POSTGRES_* only when its volume is first created.
POSTGRES_PASSWORD=
PGADMIN_DEFAULT_PASSWORD=
# Defaults shown; must stay consistent with DATABASE_URL and
# deploy/pgadmin/servers.json.
# POSTGRES_USER=flight
# POSTGRES_DB=flights
# PGADMIN_DEFAULT_EMAIL=dev@example.com

# ── Connection strings ─────────────────────────────────────────────────────
# Kafka: local PLAINTEXT ↔ cloud SASL_SSL is a two-line diff. Username,
# password and mechanism are only used for SASL_* protocols.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_USERNAME=
KAFKA_PASSWORD=

# Redis — BFF hot-cache read model + liveness writer.
REDIS_URL=redis://127.0.0.1:6379/0

# PostgreSQL — cold store (db sink, pipeline_status) + itinerary engine.
# Empty ⇒ the planner serves its demo seed; the db sink and
# scripts/pipeline_status.py refuse to run (there is no built-in credential).
#   DATABASE_URL=postgresql://flight:<POSTGRES_PASSWORD>@127.0.0.1:5432/flights?sslmode=disable
DATABASE_URL=

# ── AI Itinerary Planner (src/itinerary) ───────────────────────────────────
# Any OpenAI-compatible gateway. Plain OpenAI: leave OPENAI_BASE_URL empty.
# OpenRouter (one key → many vendors):
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   TOROB_ITINERARY_MODEL=google/gemini-3.1-pro-preview
# Empty OPENAI_API_KEY ⇒ deterministic fallback narrative + popularity
# ranking (the planner fully works offline).
OPENAI_API_KEY=
OPENAI_BASE_URL=
TOROB_ITINERARY_MODEL=gpt-4o-mini
# Gateway unreachable from your network? Route httpx through a local SOCKS
# proxy (needs the httpx[socks] extra):
# ALL_PROXY=socks5h://127.0.0.1:10808

# ── Kafka topics (kafka-init provisions these; services self-provision too) ─
RAW_TOPIC=raw_flight_prices
CANONICAL_TOPIC=flight-prices.canonical
DELTAS_TOPIC=flight-prices.deltas
SEARCH_REQUESTS_TOPIC=search.requests
KAFKA_DLQ_TOPIC=scraper.dlq
# Self-provisioning shape + producer flush budget.
RAW_TOPIC_PARTITIONS=3
RAW_TOPIC_REPLICATION=1
CANONICAL_TOPIC_PARTITIONS=3
CANONICAL_TOPIC_REPLICATION=1
KAFKA_FLUSH_TIMEOUT_SECONDS=30

# ── Worker fan-out (cadence pass) ──────────────────────────────────────────
# SUPPLIERS: comma list of flytoday,alibaba
# ROUTES:    comma list of ORIGIN-DEST pairs, e.g. THR-MHD,THR-SYZ
# DEPARTURE_DATE: Gregorian ISO date; CABIN: cabin code (Y = economy)
SUPPLIERS=flytoday
ROUTES=THR-MHD
DEPARTURE_DATE=2026-11-15
ADULTS=1
CHILDREN=0
INFANTS=0
CABIN=Y

# ── Supplier identity & session cadence ────────────────────────────────────
# Empty SCRAPER_USER_AGENT ⇒ the built-in desktop Chrome identity
# (pipelines/suppliers/base.py). scripts/verify_pipeline.sh probes with it too.
SCRAPER_USER_AGENT=
ALIBABA_POLL_INTERVAL_SECONDS=2
ALIBABA_MAX_POLLS=11

# ── Politeness budget / circuit breaker / scheduler ────────────────────────
RATE_BUCKET_CAPACITY=6
RATE_SEARCHES_PER_MINUTE=6
SEARCH_GAP_SECONDS=2
CIRCUIT_BLOCKED_THRESHOLD=3
CIRCUIT_ERROR_THRESHOLD=5
SCRAPE_INTERVAL_SECONDS=900
# Fraction of the interval, capped at 0.90.
SCRAPE_JITTER_PERCENT=0.30
SCRAPE_RUN_ON_START=true

# ── Supplier HTTP resilience ───────────────────────────────────────────────
SUPPLIER_HTTP_TIMEOUT_SECONDS=20
SCRAPER_MAX_RETRIES=3
SCRAPER_BACKOFF_BASE_SECONDS=2
SCRAPER_BACKOFF_MAX_SECONDS=30

# ── Worker disk spool (no data loss on broker outage) ──────────────────────
SPOOL_ENABLED=true
SPOOL_DIR=.spool

# ── On-demand scans (BFF cache-miss → worker search.requests consumer) ─────
ON_DEMAND_SCANS=true
ON_DEMAND_GROUP_ID=raw-worker-ondemand
# How long a route-day stays deduped after its scan is queued. Must exceed
# scan+normalize+liveness latency (~30 s); keep ≤ LIVENESS_TTL_SECONDS so a
# search made after the quotes expire always triggers a rescan.
ON_DEMAND_DEDUP_SECONDS=60

# ── Consumer groups ────────────────────────────────────────────────────────
NORMALIZER_GROUP_ID=flight-normalizer
SINK_GROUP_ID=flight-db-sink
LIVENESS_GROUP_ID=flight-liveness

# ── DB sink resilience (docker-compose.pipeline.yml sets 10 attempts) ──────
DB_CONNECT_ATTEMPTS=5
DB_WRITE_RETRIES=3

# ── Liveness writer ────────────────────────────────────────────────────────
LIVENESS_TTL_SECONDS=120
# Batch window — cache-fill latency after a scan lands.
LIVENESS_MAX_WAIT_SECONDS=0.5

# ── BFF tuning thresholds ──────────────────────────────────────────────────
# Skeleton re-polls (≈2 s each, ≈30 s budget) and offers-modal re-polls
# (≈16 s budget); on-demand scan dedupe window in seconds.
TOROB_MAX_POLL_ATTEMPTS=15
TOROB_MAX_OFFER_POLL_ATTEMPTS=8
TOROB_SCAN_REQUEST_MIN_INTERVAL=10
# Commented out — an empty value is NOT treated as unset for these:
# TOROB_FORCE_MOCK=1
# TOROB_LOG_LEVEL=INFO
# >1 ⇒ multi-process uvicorn (stateless read model by design); 4 in prod.
# TOROB_WEB_WORKERS=1
# 0 in prod: skip per-render template mtime checks.
# TOROB_TEMPLATE_AUTORELOAD=1
# Overrides ALL planner cache TTLs (places 300 / narrative 600 /
# embeddings 900); 0 disables planner caching.
# TOROB_ITINERARY_CACHE_TTL_SECONDS=

# ── Pipeline containers only (docker-compose.pipeline.yml) ─────────────────
# Inside the compose network use the INTERNAL listeners, not localhost.
# PIPELINE_DATABASE_URL defaults to one built from POSTGRES_* above.
# PIPELINE_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# PIPELINE_REDIS_URL=redis://redis:6379/0
# PIPELINE_DATABASE_URL=postgresql://flight:<POSTGRES_PASSWORD>@postgres:5432/flights?sslmode=disable

# ── Ops scripts ────────────────────────────────────────────────────────────
# scripts/verify_pipeline.sh artifact directory.
# VERIFY_LOG_DIR=.verify

LOG_LEVEL=INFO
