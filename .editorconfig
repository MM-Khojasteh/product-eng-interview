# https://editorconfig.org — mirrors the conventions already in the tree.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,sh,sql}]
indent_size = 4

[Dockerfile]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Third-party and generated files are never hand-edited.
[{static/vendor/**,static/css/torob.css}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
